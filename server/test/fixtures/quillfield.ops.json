       "label": "Account is closed or frozen",
       "then": [
        {
         "id": "a5",
         "do": "Put the pay run on hold and request a new funding account with a voided check.",
         "evidence": 2
        }
       ],
       "else": [
        {
         "id": "a6",
         "do": "Retry the debit once and attach the bank return code to the ticket.",
         "evidence": 4
        }
       ]
