          {
           "id": "r7",
           "escalate": "Request approval in #finance-approvals, then issue a prorated credit.",
           "owner": "Finance",
           "evidence": 2
          }
         ],
         "else": [
          {
           "id": "r8",
           "do": "Issue a prorated credit for the unused months.",
           "evidence": 5
          }
         ]
        }
       ]
      }
